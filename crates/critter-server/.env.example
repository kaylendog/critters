# Copy to .env for `cargo run -p critter-server` against `docker compose up -d`
# Postgres. The binary loads it at start, and sqlx::query!() reads it at
# compile time.
DATABASE_URL=postgres://critters:critters@localhost:5432/critter_server
# Optional. When unset the server generates a random token and logs it at start.
ADMIN_TOKEN=
# Wikimedia asks for contact info in the User-Agent.
USER_AGENT=critter-server (https://github.com/kaylendog/daily-critters)
DATA_DIR=./data
RUST_LOG=critter_server=debug,tower_http=info
