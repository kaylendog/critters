  "query": "select id, url, species, cadence, last_fired_slot, created_at\n         from webhooks\n         where (cadence = 'hourly' and (last_fired_slot is null or last_fired_slot < $1))\n            or (cadence = 'daily' and (last_fired_slot is null or last_fired_slot < $2))\n         order by created_at",
