# Copy to .env for `cargo run -p critter-discord` against `docker compose up -d`
# Postgres. The binary loads it at start, and sqlx::query!() reads it at
# compile time.
DATABASE_URL=postgres://critters:critters@localhost:5432/critter_discord
# Optional. When unset the pusher generates a random token and logs it at start.
ADMIN_TOKEN=
# The critter-server instance to pull photos from.
SERVER_URL=http://localhost:8080
BIND_ADDR=0.0.0.0:8081
RUST_LOG=critter_discord=debug,tower_http=info
