# Copy to .env for `cargo run` against `docker compose up -d` Postgres.
DATABASE_URL=postgres://critters:critters@localhost:5432/critters
# Optional. When unset the server generates a random token and logs it at start.
ADMIN_TOKEN=
# Wikimedia asks for contact info in the User-Agent.
USER_AGENT=daily-critters (https://github.com/kaylendog/daily-critters)
DATA_DIR=./data
RUST_LOG=daily_critters=debug,tower_http=info
