# Copy to docker/.env for `docker compose -f docker/compose.prod.yml`. Compose
# reads it from the directory of the compose file.

# Required in production.
POSTGRES_PASSWORD=
# This bot's public HTTPS address. Set the Interactions Endpoint URL in the
# Discord Developer Portal to the same host plus `/interactions`.
DISCORD_PUBLIC_URL=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=

# Optional. A release version such as 0.1.0. Defaults to the latest release.
CRITTERS_VERSION=
# Optional. Generated and logged on start when unset.
SERVER_ADMIN_TOKEN=
